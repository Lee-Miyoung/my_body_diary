{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['name','birthDate','email'])"
        },
        "diary": {
          "$date": {
            ".validate": "newData.hasChildren(['date','birthDate']) && newData.child('date').val() === $date"
          }
        }
      }
    }
  }
}
