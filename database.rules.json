{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "crypto": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['version','passwordSalt','passwordWrapped','recoveryWrapped','recoveryHash'])"
        },
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['email','encrypted']) && newData.child('email').val() === auth.token.email"
        },
        "diary": {
          "$date": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['encrypted','updatedAt']) && $date.matches(/^\\d{4}-\\d{2}-\\d{2}$/))"
          }
        }
      }
    }
  }
}